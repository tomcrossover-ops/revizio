{"format":"revizio-pack","version":1,"courses":[{"level":"CM2","subject":"francais","catalogTitle":"Nature des mots","title":"Nature des mots","duration":20,"summary":"Nom, déterminant, adjectif, pronom, verbe, adverbe, préposition.","objectives":["Reconnaître la nature"],"prerequisites":["Groupe nominal"],"pitfalls":["Hors contexte"],"lesson":[{"title":"Mots variables","content":"Nom, déterminant, adjectif, pronom, verbe varient en genre, nombre ou temps.","examples":["les petits chats"]},{"title":"Mots invariables","content":"Adverbe (vite, très), préposition (à, de, dans), conjonction (et, mais).","examples":["Il court vite."]},{"title":"Méthode","content":"Remplacer par un mot de même nature. « la » : déterminant ou pronom.","examples":["Je la vois (pronom)"]}],"keyPoints":["Nature selon le contexte","Variables / invariables"],"cards":[{"q":"Adverbe ?","a":"Invariable, précise un verbe","explain":"","tag":""},{"q":"Préposition ?","a":"à, de, dans, sur…","explain":"","tag":""},{"q":"Pronom ?","a":"Remplace un nom","explain":"","tag":""},{"q":"Déterminant ?","a":"Précède le nom","explain":"","tag":""},{"q":"Adjectif ?","a":"Précise le nom","explain":"","tag":""},{"q":"Verbe ?","a":"Action ou état, se conjugue","explain":"","tag":""},{"q":"Conjonction ?","a":"Relie (et, mais, ou…)","explain":"","tag":""},{"q":"« la » ?","a":"Déterminant ou pronom","explain":"","tag":""}],"questions":[{"type":"qcm","q":"Dans « Il court vite », « vite » est…","choices":["adjectif","adverbe","nom","préposition"],"answer":1,"explanation":"Invariable.","level":1,"skill":"adverbe"},{"type":"qcm","q":"Dans « Je la vois », « la » est…","choices":["déterminant","pronom","adjectif","verbe"],"answer":1,"explanation":"Remplace un nom.","level":2,"skill":"pronom"},{"type":"trous","q":"« à » dans « Il parle à Paul » est une ___.","answer":"préposition","accept":["preposition"],"explanation":"Préposition.","level":1,"skill":"préposition"},{"type":"vf","q":"Un adverbe s'accorde.","answer":false,"explanation":"Invariable.","level":1,"skill":"adverbe"},{"type":"assoc","q":"Relie chaque mot à sa nature.","pairs":[["chat","nom"],["le","déterminant"],["petit","adjectif"],["court","verbe"]],"explanation":"Natures.","level":1,"skill":"nature"},{"type":"qcm","q":"Quel mot est invariable ?","choices":["grand","souvent","chanter","chat"],"answer":1,"explanation":"Adverbe.","level":2,"skill":"invariables"},{"type":"vf","q":"La nature dépend du contexte.","answer":true,"explanation":"Oui.","level":2,"skill":"méthode"},{"type":"short","q":"Nature de « mais » ?","answer":"conjonction","accept":["conjonction de coordination"],"explanation":"Coordination.","level":2,"skill":"conjonction"}]},{"level":"CM2","subject":"francais","catalogTitle":"Fonctions dans la phrase","title":"Fonctions dans la phrase","duration":25,"summary":"Sujet, COD, COI, attribut du sujet, compléments circonstanciels.","objectives":["Identifier les fonctions"],"prerequisites":["Nature des mots"],"pitfalls":["COD / attribut"],"lesson":[{"title":"Sujet et COD","content":"Sujet : qui fait l'action (c'est… qui). COD : Quoi ? Qui ? après le verbe, sans préposition.","examples":["Léa mange une pomme."]},{"title":"COI et attribut","content":"COI : à qui ? de quoi ? (préposition). Attribut du sujet : après un verbe d'état (être, paraître, sembler, devenir) ; il qualifie le sujet.","examples":["Il parle à Paul. / Léa est contente."]},{"title":"Compléments circonstanciels","content":"Lieu, temps, manière… déplaçables et supprimables.","examples":["Hier, il joue dans le jardin."]}],"keyPoints":["COD sans préposition","Attribut après être","CC supprimables"],"cards":[{"q":"COD ?","a":"Complète le verbe sans préposition","explain":"","tag":""},{"q":"COI ?","a":"Complète le verbe avec préposition","explain":"","tag":""},{"q":"Attribut du sujet ?","a":"Qualifie le sujet après être","explain":"","tag":""},{"q":"CC de lieu ?","a":"Où ?","explain":"","tag":""},{"q":"CC de temps ?","a":"Quand ?","explain":"","tag":""},{"q":"CC de manière ?","a":"Comment ?","explain":"","tag":""},{"q":"Verbes d'état ?","a":"être, sembler, paraître, devenir","explain":"","tag":""},{"q":"Le CC est-il supprimable ?","a":"Oui","explain":"","tag":""}],"questions":[{"type":"qcm","q":"« Léa mange une pomme » : « une pomme » est…","choices":["COD","COI","attribut","CC"],"answer":0,"explanation":"Quoi ?","level":1,"skill":"COD"},{"type":"qcm","q":"« Il parle à Paul » : « à Paul » est…","choices":["COD","COI","attribut","CC"],"answer":1,"explanation":"À qui ?","level":1,"skill":"COI"},{"type":"qcm","q":"« Léa est contente » : « contente » est…","choices":["COD","COI","attribut du sujet","CC"],"answer":2,"explanation":"Après être.","level":2,"skill":"attribut"},{"type":"qcm","q":"« Hier » est un CC de…","choices":["lieu","temps","manière","but"],"answer":1,"explanation":"Quand ?","level":1,"skill":"CC"},{"type":"vf","q":"On peut supprimer un COD.","answer":false,"explanation":"Non.","level":2,"skill":"COD"},{"type":"trous","q":"Un attribut du sujet suit un verbe d'___.","answer":"état","accept":["etat"],"explanation":"Être.","level":2,"skill":"attribut"},{"type":"assoc","q":"Relie chaque fonction à sa question.","pairs":[["COD","quoi ? qui ?"],["COI","à qui ? de quoi ?"],["CC de lieu","où ?"],["CC de temps","quand ?"]],"explanation":"Questions.","level":2,"skill":"questions"},{"type":"short","q":"Fonction de « une lettre » dans « Paul écrit une lettre » ?","answer":"COD","accept":["complément d'objet direct"],"explanation":"Quoi ?","level":1,"skill":"COD"}]},{"level":"CM2","subject":"francais","catalogTitle":"Phrase simple et complexe","title":"Phrase simple et complexe","duration":20,"summary":"Juxtaposition, coordination, proposition.","objectives":["Compter les propositions"],"prerequisites":["Verbes"],"pitfalls":["Verbe à l'infinitif"],"lesson":[{"title":"Phrase simple / complexe","content":"Phrase simple : un seul verbe conjugué (une proposition). Phrase complexe : plusieurs verbes conjugués (plusieurs propositions).","examples":["Le chat dort. / Le chat dort et il rêve."]},{"title":"Juxtaposition et coordination","content":"Juxtaposées : séparées par une virgule ou un point-virgule. Coordonnées : reliées par mais, ou, et, donc, or, ni, car.","examples":["Il vient, il mange. / Il vient mais il part."]},{"title":"Compter","content":"Une proposition = un verbe conjugué.","examples":["Je pense qu'il vient : 2 propositions"]}],"keyPoints":["1 verbe conjugué = 1 proposition","Juxtaposition","Coordination"],"cards":[{"q":"Phrase simple ?","a":"Un verbe conjugué","explain":"","tag":""},{"q":"Phrase complexe ?","a":"Plusieurs verbes conjugués","explain":"","tag":""},{"q":"Juxtaposées ?","a":"Séparées par une ponctuation","explain":"","tag":""},{"q":"Coordonnées ?","a":"Reliées par une conjonction de coordination","explain":"","tag":""},{"q":"Conjonctions de coordination ?","a":"mais, ou, et, donc, or, ni, car","explain":"","tag":""},{"q":"Proposition ?","a":"Groupe autour d'un verbe conjugué","explain":"","tag":""},{"q":"Infinitif compte-t-il ?","a":"Non, pas conjugué","explain":"","tag":""},{"q":"Virgule entre deux verbes ?","a":"Juxtaposition","explain":"","tag":""}],"questions":[{"type":"qcm","q":"« Le chat dort et il rêve » est…","choices":["simple","complexe","sans verbe","impérative"],"answer":1,"explanation":"Deux verbes.","level":1,"skill":"type"},{"type":"qcm","q":"Combien de propositions dans « Il dort et elle rêve » ?","choices":["1","2","3","4"],"answer":1,"explanation":"Deux verbes conjugués.","level":2,"skill":"compter"},{"type":"vf","q":"« Il vient, il mange » : propositions juxtaposées.","answer":true,"explanation":"Virgule.","level":1,"skill":"juxtaposition"},{"type":"trous","q":"« mais » est une conjonction de ___.","answer":"coordination","accept":[],"explanation":"Coordination.","level":1,"skill":"coordination"},{"type":"assoc","q":"Relie chaque exemple à son type.","pairs":[["Il vient, il mange","juxtaposition"],["Il vient mais il part","coordination"]],"explanation":"Types.","level":2,"skill":"types"},{"type":"vf","q":"Une phrase simple contient un seul verbe conjugué.","answer":true,"explanation":"Oui.","level":1,"skill":"type"},{"type":"qcm","q":"Combien de propositions : « Je pense qu'il vient » ?","choices":["1","2","3","0"],"answer":1,"explanation":"Deux verbes.","level":2,"skill":"compter"},{"type":"vf","q":"Un verbe à l'infinitif forme une proposition.","answer":false,"explanation":"Il faut un verbe conjugué.","level":2,"skill":"compter"}]},{"level":"CM2","subject":"francais","catalogTitle":"Conjugaison : présent et futur","title":"Conjugaison : présent et futur","duration":25,"summary":"Verbes des 3 groupes; irréguliers fréquents.","objectives":["Conjuguer au présent et au futur"],"prerequisites":["Groupes"],"pitfalls":["vous disez"],"lesson":[{"title":"Présent","content":"1er groupe : -e, -es, -e, -ons, -ez, -ent. 2e : -is, -is, -it, -issons, -issez, -issent. 3e : variable.","examples":["je chante, nous finissons"]},{"title":"Irréguliers","content":"être : suis, es, est, sommes, êtes, sont. avoir : ai, as, a, avons, avez, ont. aller : vais, vas, va, allons, allez, vont. faire : fais… faites, font. dire : dites.","examples":["vous faites, vous dites"]},{"title":"Futur","content":"Infinitif + ai, as, a, ons, ez, ont. Irréguliers : serai, aurai, irai, ferai, viendrai, verrai, pourrai.","examples":["je chanterai, j'irai"]}],"keyPoints":["Terminaisons des 3 groupes","Irréguliers","Futur : r"],"cards":[{"q":"être : vous","a":"êtes","explain":"","tag":""},{"q":"faire : vous","a":"faites","explain":"","tag":""},{"q":"dire : vous","a":"dites","explain":"","tag":""},{"q":"aller : ils","a":"vont","explain":"","tag":""},{"q":"avoir : ils","a":"ont","explain":"","tag":""},{"q":"Futur d'être : je","a":"serai","explain":"","tag":""},{"q":"Futur d'aller : j'","a":"irai","explain":"","tag":""},{"q":"Futur de faire : je","a":"ferai","explain":"","tag":""}],"questions":[{"type":"trous","q":"Vous ___ (faire) du bruit. Présent.","answer":"faites","accept":[],"explanation":"Faire.","level":1,"skill":"présent"},{"type":"trous","q":"Ils ___ (aller) au parc. Présent.","answer":"vont","accept":[],"explanation":"Aller.","level":1,"skill":"présent"},{"type":"trous","q":"Demain, j'___ (aller) à la mer. Futur.","answer":"irai","accept":[],"explanation":"Irr.","level":1,"skill":"futur"},{"type":"trous","q":"Elle ___ (être) contente demain. Futur.","answer":"sera","accept":[],"explanation":"Être.","level":1,"skill":"futur"},{"type":"trous","q":"Nous ___ (finir) bientôt. Présent.","answer":"finissons","accept":[],"explanation":"2e groupe.","level":2,"skill":"présent"},{"type":"qcm","q":"Quel est le groupe de « finir » ?","choices":["1er","2e","3e","aucun"],"answer":1,"explanation":"finissons.","level":1,"skill":"groupes"},{"type":"vf","q":"Au futur, on entend le r.","answer":true,"explanation":"Oui.","level":1,"skill":"futur"},{"type":"assoc","q":"Relie chaque verbe à son futur (je).","pairs":[["avoir","aurai"],["faire","ferai"],["venir","viendrai"],["voir","verrai"]],"explanation":"Futurs.","level":2,"skill":"futur"}]},{"level":"CM2","subject":"francais","catalogTitle":"Conjugaison : imparfait et passé simple","title":"Conjugaison : imparfait et passé simple","duration":25,"summary":"Terminaisons; emploi dans un récit.","objectives":["Conjuguer","Distinguer les emplois"],"prerequisites":["Présent"],"pitfalls":["Confondre"],"lesson":[{"title":"Imparfait","content":"Radical du « nous » présent + -ais, -ais, -ait, -ions, -iez, -aient. Décor, habitude.","examples":["je chantais"]},{"title":"Passé simple","content":"1er groupe : -a, -èrent. 2e : -it, -irent. Être : fut, furent. Avoir : eut, eurent. Actions du récit.","examples":["il chanta, ils finirent"]},{"title":"Dans un récit","content":"Imparfait = fond; passé simple = actions.","examples":["Il pleuvait quand il sortit."]}],"keyPoints":["Imparfait : fond","Passé simple : actions","Terminaisons"],"cards":[{"q":"Imparfait : terminaisons","a":"-ais, -ais, -ait, -ions, -iez, -aient","explain":"","tag":""},{"q":"Passé simple chanter : il","a":"chanta","explain":"","tag":""},{"q":"Passé simple finir : ils","a":"finirent","explain":"","tag":""},{"q":"Passé simple être : il","a":"fut","explain":"","tag":""},{"q":"Passé simple avoir : il","a":"eut","explain":"","tag":""},{"q":"Imparfait être : j'","a":"étais","explain":"","tag":""},{"q":"Imparfait pour…","a":"Décor, habitude","explain":"","tag":""},{"q":"Passé simple pour…","a":"Actions successives","explain":"","tag":""}],"questions":[{"type":"trous","q":"Autrefois, il ___ (aller) à pied. Imparfait.","answer":"allait","accept":[],"explanation":"Imparfait.","level":1,"skill":"imparfait"},{"type":"trous","q":"Il ___ (chanter) une chanson. Passé simple.","answer":"chanta","accept":[],"explanation":"-a.","level":1,"skill":"passé simple"},{"type":"trous","q":"Ils ___ (finir) tôt. Passé simple.","answer":"finirent","accept":[],"explanation":"-irent.","level":2,"skill":"passé simple"},{"type":"trous","q":"Elle ___ (être) surprise. Passé simple.","answer":"fut","accept":[],"explanation":"Être.","level":1,"skill":"passé simple"},{"type":"qcm","q":"Dans « Il pleuvait quand il sortit », « sortit » est…","choices":["imparfait","passé simple","présent","futur"],"answer":1,"explanation":"Action.","level":1,"skill":"emplois"},{"type":"vf","q":"L'imparfait décrit le décor.","answer":true,"explanation":"Oui.","level":1,"skill":"emplois"},{"type":"assoc","q":"Relie chaque temps à son rôle.","pairs":[["Imparfait","décor"],["Passé simple","action"]],"explanation":"Rôles.","level":1,"skill":"emplois"},{"type":"trous","q":"J'___ (avoir) peur. Imparfait.","answer":"avais","accept":[],"explanation":"Avoir.","level":1,"skill":"imparfait"}]},{"level":"CM2","subject":"francais","catalogTitle":"Conjugaison : passé composé et plus-que-parfait","title":"Conjugaison : passé composé et plus-que-parfait","duration":25,"summary":"Auxiliaires, participes passés, accords.","objectives":["Former","Accorder"],"prerequisites":["Présent"],"pitfalls":["Accord"],"lesson":[{"title":"Passé composé","content":"Auxiliaire au présent + participe passé : j'ai mangé, elle est partie.","examples":["Nous avons chanté"]},{"title":"Plus-que-parfait","content":"Auxiliaire à l'imparfait + participe : j'avais mangé, elle était partie. Action antérieure.","examples":["Quand il arriva, elle était partie."]},{"title":"Accord","content":"Avec être, accord avec le sujet. Avec avoir, accord avec le COD placé avant.","examples":["Elles sont parties. Les pommes que j'ai mangées."]}],"keyPoints":["Auxiliaire + participe","Plus-que-parfait = avant","Accord"],"cards":[{"q":"Passé composé ?","a":"Auxiliaire au présent + participe","explain":"","tag":""},{"q":"Plus-que-parfait ?","a":"Auxiliaire à l'imparfait + participe","explain":"","tag":""},{"q":"Participe de prendre","a":"pris","explain":"","tag":""},{"q":"Participe de voir","a":"vu","explain":"","tag":""},{"q":"Auxiliaire de partir","a":"être","explain":"","tag":""},{"q":"Accord avec être ?","a":"Avec le sujet","explain":"","tag":""},{"q":"Accord avec avoir ?","a":"COD placé avant","explain":"","tag":""},{"q":"Participe de faire","a":"fait","explain":"","tag":""}],"questions":[{"type":"qcm","q":"Elle ___ partie.","choices":["a","est","ont","sont"],"answer":1,"explanation":"Être.","level":1,"skill":"auxiliaire"},{"type":"qcm","q":"Elles sont ___.","choices":["parti","partie","partis","parties"],"answer":3,"explanation":"Féminin pluriel.","level":2,"skill":"accord"},{"type":"trous","q":"J'___ mangé. Passé composé de manger.","answer":"ai","accept":[],"explanation":"Avoir.","level":1,"skill":"passé composé"},{"type":"trous","q":"Elle ___ partie avant. Plus-que-parfait.","answer":"était","accept":["etait"],"explanation":"Être imparfait.","level":2,"skill":"plus-que-parfait"},{"type":"short","q":"Participe passé de « prendre » ?","answer":"pris","accept":[],"explanation":"Irrégulier.","level":2,"skill":"participe"},{"type":"vf","q":"Avec avoir, on accorde avec le sujet.","answer":false,"explanation":"COD avant.","level":2,"skill":"accord"},{"type":"assoc","q":"Relie chaque verbe à son participe.","pairs":[["voir","vu"],["faire","fait"],["dire","dit"],["finir","fini"]],"explanation":"Participes.","level":2,"skill":"participe"},{"type":"qcm","q":"« J'avais mangé » est au…","choices":["passé composé","plus-que-parfait","imparfait","futur"],"answer":1,"explanation":"Avais + participe.","level":1,"skill":"reconnaître"}]},{"level":"CM2","subject":"francais","catalogTitle":"Impératif et conditionnel","title":"Impératif et conditionnel","duration":20,"summary":"Formation, emplois simples.","objectives":["Former l'impératif","Utiliser le conditionnel"],"prerequisites":["Présent, futur"],"pitfalls":["tu mange"],"lesson":[{"title":"Impératif","content":"Sans sujet, 3 personnes : tu, nous, vous. 1er groupe : sans s à tu (Mange !). Chante ! Chantons ! Chantez ! Irréguliers : sois, aie, va, fais, dis.","examples":["Prends ton manteau !"]},{"title":"Conditionnel","content":"Infinitif + terminaisons de l'imparfait (-ais, -ais, -ait, -ions, -iez, -aient) : je chanterais, il ferait.","examples":["Je viendrais si je pouvais."]},{"title":"Emplois","content":"Impératif : ordre, conseil. Conditionnel : politesse, souhait, hypothèse.","examples":["Je voudrais un café."]}],"keyPoints":["Impératif sans sujet","Conditionnel = futur + imparfait","Politesse"],"cards":[{"q":"Impératif de manger (tu)","a":"Mange (sans s)","explain":"","tag":""},{"q":"Impératif d'être (tu)","a":"Sois","explain":"","tag":""},{"q":"Impératif d'avoir (tu)","a":"Aie","explain":"","tag":""},{"q":"Conditionnel de chanter (je)","a":"chanterais","explain":"","tag":""},{"q":"Conditionnel d'être (il)","a":"serait","explain":"","tag":""},{"q":"Conditionnel d'aller (je)","a":"irais","explain":"","tag":""},{"q":"Conditionnel pour…","a":"Politesse, souhait","explain":"","tag":""},{"q":"Impératif a-t-il un sujet ?","a":"Non","explain":"","tag":""}],"questions":[{"type":"trous","q":"___ (manger) ton gâteau ! Impératif à tu.","answer":"Mange","accept":["mange"],"explanation":"Sans s.","level":1,"skill":"impératif"},{"type":"trous","q":"Je ___ (vouloir) un café. Conditionnel.","answer":"voudrais","accept":[],"explanation":"Politesse.","level":2,"skill":"conditionnel"},{"type":"trous","q":"Il ___ (être) content. Conditionnel.","answer":"serait","accept":[],"explanation":"Être.","level":2,"skill":"conditionnel"},{"type":"vf","q":"L'impératif se conjugue avec un sujet.","answer":false,"explanation":"Sans sujet.","level":1,"skill":"impératif"},{"type":"qcm","q":"« Prends ton manteau ! » est à l'…","choices":["impératif","indicatif","conditionnel","subjonctif"],"answer":0,"explanation":"Ordre.","level":1,"skill":"reconnaître"},{"type":"assoc","q":"Relie chaque verbe à son impératif (tu).","pairs":[["être","sois"],["avoir","aie"],["aller","va"],["faire","fais"]],"explanation":"Irréguliers.","level":2,"skill":"impératif"},{"type":"qcm","q":"Le conditionnel exprime…","choices":["la politesse ou l'hypothèse","un ordre","le passé","le présent"],"answer":0,"explanation":"Emplois.","level":1,"skill":"emplois"},{"type":"trous","q":"Si j'avais le temps, je ___ (venir).","answer":"viendrais","accept":[],"explanation":"Conditionnel.","level":3,"skill":"conditionnel"}]},{"level":"CM2","subject":"francais","catalogTitle":"Orthographe : accords","title":"Orthographe : accords","duration":25,"summary":"Sujet-verbe, groupe nominal, participe passé avec être.","objectives":["Accorder"],"prerequisites":["Nature, fonctions"],"pitfalls":["Sujet éloigné"],"lesson":[{"title":"Sujet-verbe","content":"Le verbe s'accorde avec le sujet, même éloigné ou inversé.","examples":["Les enfants de ma voisine jouent."]},{"title":"Groupe nominal","content":"Déterminant, nom, adjectif : même genre, même nombre. Pluriel -s ou -x (cheveux, chevaux).","examples":["des petites filles joyeuses"]},{"title":"Participe avec être","content":"Il s'accorde avec le sujet.","examples":["Elle est tombée. Ils sont arrivés."]}],"keyPoints":["Sujet-verbe","GN accordé","Participe avec être : sujet"],"cards":[{"q":"Pluriel de cheval","a":"chevaux","explain":"","tag":""},{"q":"Pluriel de bateau","a":"bateaux","explain":"","tag":""},{"q":"Féminin de heureux","a":"heureuse","explain":"","tag":""},{"q":"Féminin de léger","a":"légère","explain":"","tag":""},{"q":"Accord du verbe","a":"Avec le sujet","explain":"","tag":""},{"q":"Participe avec être","a":"Accord avec le sujet","explain":"","tag":""},{"q":"Sujet inversé ?","a":"Placé après le verbe","explain":"","tag":""},{"q":"Pluriel de bijou","a":"bijoux","explain":"","tag":""}],"questions":[{"type":"trous","q":"Les enfants de ma voisine ___ (jouer).","answer":"jouent","accept":[],"explanation":"Sujet pluriel.","level":1,"skill":"accord"},{"type":"short","q":"Pluriel de « un cheval » ?","answer":"des chevaux","accept":["chevaux"],"explanation":"-aux.","level":1,"skill":"pluriel"},{"type":"short","q":"Féminin de « heureux » ?","answer":"heureuse","accept":[],"explanation":"-euse.","level":1,"skill":"féminin"},{"type":"qcm","q":"Elle est ___.","choices":["tombé","tombée","tombés","tombées"],"answer":1,"explanation":"Féminin singulier.","level":1,"skill":"participe"},{"type":"vf","q":"Le verbe s'accorde avec le mot qui le précède.","answer":false,"explanation":"Avec le sujet.","level":2,"skill":"accord"},{"type":"assoc","q":"Relie chaque singulier à son pluriel.","pairs":[["journal","journaux"],["feu","feux"],["bateau","bateaux"]],"explanation":"Pluriels.","level":2,"skill":"pluriel"},{"type":"qcm","q":"Quelle phrase est correcte ?","choices":["les petites fille joyeuse","les petites filles joyeuses","les petit filles","les petites filles joyeuse"],"answer":1,"explanation":"Accords.","level":1,"skill":"GN"},{"type":"trous","q":"Ils sont ___ (arriver).","answer":"arrivés","accept":["arrives"],"explanation":"Masculin pluriel.","level":2,"skill":"participe"}]},{"level":"CM2","subject":"francais","catalogTitle":"Homophones","title":"Homophones","duration":20,"summary":"a/à, ou/où, ce/se, ces/ses, leur/leurs, quand/qu'en.","objectives":["Distinguer"],"prerequisites":["Nature des mots"],"pitfalls":["Astuces"],"lesson":[{"title":"Les couples","content":"a/à (avait), ou/où (ou bien / lieu), ce/se (se + verbe), ces/ses (ceux-là / mes), leur/leurs.","examples":["Il a faim. Où vas-tu ?"]},{"title":"leur / leurs","content":"leur pronom (invariable) : Je leur parle. leur déterminant : prend un s si le nom est pluriel : leurs amis.","examples":["Je leur donne leurs livres."]},{"title":"quand / quant / qu'en","content":"quand = moment. qu'en = que + en. quant à = pour ce qui est de.","examples":["Quand viens-tu ?"]}],"keyPoints":["a → avait","ses → mes","leur pronom invariable"],"cards":[{"q":"a ou à : il … faim","a":"a","explain":"","tag":""},{"q":"ses ou ces ?","a":"ses = mes; ces = ceux-là","explain":"","tag":""},{"q":"ce ou se ?","a":"se + verbe pronominal","explain":"","tag":""},{"q":"leur pronom ?","a":"invariable","explain":"","tag":""},{"q":"leur déterminant ?","a":"leurs si pluriel","explain":"","tag":""},{"q":"quand ?","a":"moment","explain":"","tag":""},{"q":"ou ou où ?","a":"où = lieu","explain":"","tag":""},{"q":"Astuce de a ?","a":"avait","explain":"","tag":""}],"questions":[{"type":"qcm","q":"Il ___ faim.","choices":["a","à"],"answer":0,"explanation":"Avait.","level":1,"skill":"a/à"},{"type":"qcm","q":"Il ___ lave les mains.","choices":["ce","se"],"answer":1,"explanation":"Verbe pronominal.","level":1,"skill":"ce/se"},{"type":"qcm","q":"Léa range ___ affaires. (à elle)","choices":["ces","ses"],"answer":1,"explanation":"Mes affaires.","level":1,"skill":"ces/ses"},{"type":"qcm","q":"Je ___ parle. (à eux)","choices":["leur","leurs"],"answer":0,"explanation":"Pronom invariable.","level":2,"skill":"leur"},{"type":"qcm","q":"Ce sont ___ amis.","choices":["leur","leurs"],"answer":1,"explanation":"Nom pluriel.","level":2,"skill":"leur"},{"type":"trous","q":"___ vas-tu ? (lieu)","answer":"Où","accept":["où","ou"],"explanation":"Lieu.","level":1,"skill":"ou/où"},{"type":"vf","q":"« leur » pronom prend un s.","answer":false,"explanation":"Invariable.","level":2,"skill":"leur"},{"type":"assoc","q":"Relie chaque homophone à son astuce.","pairs":[["a","avait"],["ses","mes"],["ces","ceux-là"]],"explanation":"Astuces.","level":2,"skill":"astuces"}]},{"level":"CM2","subject":"francais","catalogTitle":"Vocabulaire : formation des mots","title":"Vocabulaire : formation des mots","duration":20,"summary":"Préfixes, suffixes, radical; sens propre et figuré; synonymes.","objectives":["Analyser un mot","Sens figuré"],"prerequisites":["Familles"],"pitfalls":["Sens propre / figuré"],"lesson":[{"title":"Radical, préfixe, suffixe","content":"Radical = noyau. Préfixe avant (re-, in-, dé-). Suffixe après (-eur, -ment, -able).","examples":["refaire, lavable"]},{"title":"Sens propre et figuré","content":"Sens propre : sens premier. Figuré : image.","examples":["Brûler du bois / brûler d'impatience"]},{"title":"Synonymes","content":"Mots de sens proche : grand/immense, content/heureux.","examples":["rapide ≈ vite"]}],"keyPoints":["Préfixe avant","Suffixe après","Sens figuré"],"cards":[{"q":"Radical ?","a":"Noyau commun","explain":"","tag":""},{"q":"Préfixe ?","a":"Avant le radical","explain":"","tag":""},{"q":"Suffixe ?","a":"Après le radical","explain":"","tag":""},{"q":"re- ?","a":"De nouveau","explain":"","tag":""},{"q":"-able ?","a":"Qui peut être","explain":"","tag":""},{"q":"Sens figuré ?","a":"Sens imagé","explain":"","tag":""},{"q":"Synonyme de content","a":"heureux","explain":"","tag":""},{"q":"Contraire de possible","a":"impossible","explain":"","tag":""}],"questions":[{"type":"qcm","q":"Dans « refaire », « re- » est…","choices":["suffixe","préfixe","radical","nom"],"answer":1,"explanation":"Avant.","level":1,"skill":"préfixe"},{"type":"qcm","q":"Dans « lavable », « -able » est…","choices":["préfixe","suffixe","radical","verbe"],"answer":1,"explanatio