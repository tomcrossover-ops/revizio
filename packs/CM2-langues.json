ains","a":"bathroom","explain":"","tag":""},{"q":"bibliothèque","a":"library","explain":"","tag":""},{"q":"Il y a un parc","a":"There is a park","explain":"","tag":""},{"q":"Il y a deux magasins","a":"There are two shops","explain":"","tag":""},{"q":"some ou any dans l'affirmatif ?","a":"some","explain":"","tag":""},{"q":"some ou any dans la question ?","a":"any","explain":"","tag":""}],"questions":[{"type":"qcm","q":"There ___ two shops.","choices":["is","are","am","be"],"answer":1,"explanation":"Pluriel.","level":1,"skill":"there"},{"type":"qcm","q":"There ___ a park.","choices":["is","are","have","has"],"answer":0,"explanation":"Singulier.","level":1,"skill":"there"},{"type":"trous","q":"I have ___ bread.","answer":"some","accept":[],"explanation":"Affirmatif.","level":1,"skill":"some/any"},{"type":"trous","q":"Do you have ___ milk ?","answer":"any","accept":[],"explanation":"Question.","level":1,"skill":"some/any"},{"type":"assoc","q":"Relie chaque mot à sa traduction.","pairs":[["kitchen","cuisine"],["library","bibliothèque"],["bedroom","chambre"],["garden","jardin"]],"explanation":"Vocabulaire.","level":1,"skill":"vocabulaire"},{"type":"vf","q":"« There is two shops » est correct.","answer":false,"explanation":"There are.","level":1,"skill":"there"},{"type":"short","q":"Traduis : « Il y a du fromage ».","answer":"There is some cheese","accept":["there is some cheese"],"explanation":"some.","level":2,"skill":"some/any"},{"type":"qcm","q":"There isn't ___ cheese.","choices":["some","any","a","an"],"answer":1,"explanation":"Négation.","level":2,"skill":"some/any"}]},{"level":"CM2","subject":"langues","catalogTitle":"Le présent continu","title":"Le présent continu","duration":20,"summary":"be + verbe en -ing; décrire une image.","objectives":["Former le présent continu"],"prerequisites":["be"],"pitfalls":["Oublier be"],"lesson":[{"title":"Formation","content":"be (am/is/are) + verbe-ing : I am reading. She is playing.","examples":["He is running"]},{"title":"Emploi","content":"Action en cours : now, at the moment. Pour décrire une image : In the picture, a girl is reading.","examples":["Look! It's raining"]},{"title":"Orthographe","content":"make → making, run → running, play → playing.","examples":["swim → swimming"]}],"keyPoints":["be + -ing","now","Décrire une image"],"cards":[{"q":"Formation","a":"be + verbe-ing","explain":"","tag":""},{"q":"-ing de make","a":"making","explain":"","tag":""},{"q":"-ing de run","a":"running","explain":"","tag":""},{"q":"-ing de play","a":"playing","explain":"","tag":""},{"q":"Négation","a":"She isn't reading","explain":"","tag":""},{"q":"Question","a":"Is she reading ?","explain":"","tag":""},{"q":"Mots repères","a":"now, at the moment","explain":"","tag":""},{"q":"He ... football","a":"is playing","explain":"","tag":""}],"questions":[{"type":"qcm","q":"Look ! It ___ raining.","choices":["is","are","am","does"],"answer":0,"explanation":"it is.","level":1,"skill":"forme"},{"type":"trous","q":"He is ___ (play) football.","answer":"playing","accept":[],"explanation":"-ing.","level":1,"skill":"forme"},{"type":"trous","q":"She is ___ (make) a cake.","answer":"making","accept":[],"explanation":"-e.","level":2,"skill":"orthographe"},{"type":"trous","q":"They are ___ (run).","answer":"running","accept":[],"explanation":"Doubler.","level":2,"skill":"orthographe"},{"type":"vf","q":"« I play now » est correct pour une action en cours.","answer":false,"explanation":"I am playing.","level":1,"skill":"emploi"},{"type":"short","q":"Question : She is sleeping.","answer":"Is she sleeping ?","accept":["is she sleeping"],"explanation":"Inversion.","level":2,"skill":"question"},{"type":"assoc","q":"Relie chaque verbe à son -ing.","pairs":[["swim","swimming"],["write","writing"],["play","playing"]],"explanation":"-ing.","level":2,"skill":"orthographe"},{"type":"qcm","q":"Quelle phrase est correcte ?","choices":["He plays now","He is playing now","He playing now","He does playing now"],"answer":1,"explanation":"be + -ing.","level":1,"skill":"forme"}]}]}