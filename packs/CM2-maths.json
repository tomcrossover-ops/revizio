calcul","q":"Nombre de faces d'un pavé droit :","answer":"6","explanation":"Pavé.","level":1,"skill":"solides","hint":""},{"type":"qcm","q":"Un cylindre possède…","choices":["2 disques","6 carrés","4 triangles","1 disque"],"answer":0,"explanation":"2 bases.","level":1,"skill":"solides"},{"type":"vf","q":"Un carré est un rectangle particulier.","answer":true,"explanation":"Oui.","level":2,"skill":"figures"},{"type":"assoc","q":"Relie chaque solide à ses faces.","pairs":[["Cube","6 carrés"],["Pavé","6 rectangles"],["Cylindre","2 disques"]],"explanation":"Faces.","level":2,"skill":"solides"},{"type":"qcm","q":"Le patron d'un cube comporte…","choices":["4 carrés","5 carrés","6 carrés","8 carrés"],"answer":2,"explanation":"6.","level":1,"skill":"patrons"},{"type":"trous","q":"Un triangle avec 3 côtés égaux est ___.","answer":"équilatéral","accept":["equilateral"],"explanation":"Trois.","level":2,"skill":"figures"}]},{"level":"CM2","subject":"maths","catalogTitle":"Symétrie axiale","title":"Symétrie axiale","duration":20,"summary":"Axe de symétrie; compléter une figure; tracer le symétrique.","objectives":["Trouver les axes","Tracer le symétrique"],"prerequisites":["Perpendiculaires"],"pitfalls":["Distance en biais"],"lesson":[{"title":"Axe de symétrie","content":"Une droite est un axe de symétrie si en pliant, les deux parties se superposent.","examples":["Carré : 4 axes"]},{"title":"Tracer le symétrique","content":"Pour chaque point : on trace la perpendiculaire à l'axe passant par le point, puis on reporte la même distance de l'autre côté.","examples":["Équerre + compas"]},{"title":"Propriétés","content":"La symétrie conserve longueurs, angles, aires.","examples":["Figure et symétrique superposables"]}],"keyPoints":["Pliage","⊥ à l'axe + même distance","Conserve les mesures"],"cards":[{"q":"Axes du carré ?","a":"4","explain":"","tag":""},{"q":"Axes du rectangle ?","a":"2","explain":"","tag":""},{"q":"Axes du triangle équilatéral ?","a":"3","explain":"","tag":""},{"q":"Axes du cercle ?","a":"Une infinité","explain":"","tag":""},{"q":"Symétrique d'un point de l'axe ?","a":"Lui-même","explain":"","tag":""},{"q":"La symétrie conserve…","a":"Longueurs et angles","explain":"","tag":""},{"q":"Pour tracer ?","a":"⊥ + même distance","explain":"","tag":""},{"q":"Triangle isocèle ?","a":"1 axe","explain":"","tag":""}],"questions":[{"type":"calcul","q":"Axes de symétrie d'un carré :","answer":"4","explanation":"Deux médianes + deux diagonales.","level":1,"skill":"axes","hint":""},{"type":"calcul","q":"Axes d'un rectangle non carré :","answer":"2","explanation":"Médianes.","level":1,"skill":"axes","hint":""},{"type":"calcul","q":"Axes d'un triangle équilatéral :","answer":"3","explanation":"Une par sommet.","level":1,"skill":"axes","hint":""},{"type":"vf","q":"Un segment de 5 cm a un symétrique de 5 cm.","answer":true,"explanation":"Conservation.","level":1,"skill":"propriétés"},{"type":"qcm","q":"La lettre A a combien d'axes ?","choices":["0","1","2","3"],"answer":1,"explanation":"Verticale.","level":2,"skill":"axes"},{"type":"assoc","q":"Relie chaque figure à son nombre d'axes.","pairs":[["Carré","4"],["Rectangle","2"],["Triangle équilatéral","3"],["Triangle quelconque","0"]],"explanation":"Axes.","level":2,"skill":"axes"},{"type":"vf","q":"Le symétrique d'un point de l'axe est lui-même.","answer":true,"explanation":"Oui.","level":2,"skill":"construction"},{"type":"trous","q":"Pour tracer le symétrique, on trace la ___ à l'axe.","answer":"perpendiculaire","accept":["perpendiculaire"],"explanation":"⊥.","level":2,"skill":"construction"}]},{"level":"CM2","subject":"maths","catalogTitle":"Périmètres et aires","title":"Périmètres et aires","duration":25,"summary":"Périmètre et aire du rectangle, du carré, du triangle rectangle; périmètre du cercle.","objectives":["Calculer P et A","Utiliser π"],"prerequisites":["Multiplication décimale"],"pitfalls":["Confondre P et A","Unités"],"lesson":[{"title":"Rectangle et carré","content":"P rectangle = 2 