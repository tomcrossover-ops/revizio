andeurs","duration":25,"summary":"Volume du pavé droit; contenances; conversions; durées.","objectives":["Calculer un volume","Convertir","Calculer une durée"],"prerequisites":["Aire"],"pitfalls":["Durée décimale"],"lesson":[{"title":"Volume","content":"V = L × l × h (cm³). Cube : c × c × c.","examples":["5×4×3=60 cm³"]},{"title":"Contenances","content":"1 L = 1 dm³ = 1 000 cm³ ; 1 m³ = 1 000 L ; 1 L = 100 cL = 1 000 mL.","examples":["1 L = 1 000 mL"]},{"title":"Durées","content":"1 h = 60 min = 3 600 s. On calcule en passant par l'heure pleine.","examples":["14 h 45 → 17 h 10 : 2 h 25"]}],"keyPoints":["V = L×l×h","1 L = 1 dm³","1 h = 60 min"],"cards":[{"q":"V pavé ?","a":"L × l × h","explain":"","tag":""},{"q":"V cube ?","a":"c × c × c","explain":"","tag":""},{"q":"1 L = ? cm³","a":"1 000","explain":"","tag":""},{"q":"1 m³ = ? L","a":"1 000","explain":"","tag":""},{"q":"1 h = ? s","a":"3 600","explain":"","tag":""},{"q":"1 min = ? s","a":"60","explain":"","tag":""},{"q":"1 L = ? mL","a":"1 000","explain":"","tag":""},{"q":"Heure pleine ?","a":"Méthode pour les durées","explain":"","tag":""}],"questions":[{"type":"calcul","q":"Pavé 5×4×3 : volume (cm³)","answer":"60","explanation":"Produit.","level":1,"skill":"volume","hint":""},{"type":"calcul","q":"Cube de 2 cm : volume","answer":"8","explanation":"2×2×2.","level":1,"skill":"volume","hint":""},{"type":"calcul","q":"1 m³ = ? L","answer":"1000","explanation":"1000.","level":2,"skill":"contenance","hint":""},{"type":"calcul","q":"2 h 15 min = ? min","answer":"135","explanation":"120+15.","level":2,"skill":"durées","hint":""},{"type":"calcul","q":"1 L = ? cm³","answer":"1000","explanation":"dm³.","level":1,"skill":"contenance","hint":""},{"type":"qcm","q":"De 14 h 45 à 17 h 10 :","choices":["2 h 25","3 h 25","2 h 35","3 h 5"],"answer":0,"explanation":"15+120+10.","level":2,"skill":"durées"},{"type":"vf","q":"1,5 h = 1 h 50 min.","answer":false,"explanation":"1 h 30.","level":2,"skill":"durées"},{"type":"assoc","q":"Relie chaque unité à son équivalent.","pairs":[["1 L","1 000 mL"],["1 h","3 600 s"],["1 m³","1 000 L"]],"explanation":"Équivalences.","level":2,"skill":"unités"}]},{"level":"CM2","subject":"maths","catalogTitle":"Données et graphiques","title":"Données et graphiques","duration":20,"summary":"Lire et construire tableaux, diagrammes en bâtons et courbes.","objectives":["Lire","Construire"],"prerequisites":["Tableaux"],"pitfalls":["Échelle"],"lesson":[{"title":"Lire","content":"Regarder le titre, les axes, l'échelle.","examples":["Barres = effectifs"]},{"title":"Construire","content":"Choisir une échelle adaptée, graduer régulièrement, tracer, donner un titre.","examples":["Diagramme en bâtons"]},{"title":"Moyenne","content":"Moyenne = somme ÷ nombre de valeurs.","examples":["10,12,14 → 12"]}],"keyPoints":["Titre, axes, échelle","Bâtons : effectifs","Courbe : évolution"],"cards":[{"q":"Diagramme en bâtons ?","a":"Compare des effectifs","explain":"","tag":""},{"q":"Courbe ?","a":"Évolution","explain":"","tag":""},{"q":"Moyenne ?","a":"Somme ÷ nombre","explain":"","tag":""},{"q":"Échelle ?","a":"Valeur d'un carreau","explain":"","tag":""},{"q":"Effectif total ?","a":"Somme des effectifs","explain":"","tag":""},{"q":"Axe horizontal ?","a":"Abscisses","explain":"","tag":""},{"q":"Axe vertical ?","a":"Ordonnées","explain":"","tag":""},{"q":"Moyenne de 10, 12, 14 ?","a":"12","explain":"","tag":""}],"questions":[{"type":"calcul","q":"Moyenne de 10, 12, 14 :","answer":"12","explanation":"36÷3.","level":1,"skill":"moyenne","hint":""},{"type":"calcul","q":"8+5+7 fruits : total","answer":"20","explanation":"Somme.","level":1,"skill":"effectif","hint":""},{"type":"qcm","q":"Pour une évolution on utilise…","choices":["une courbe","un camembert","un tableau seul","un schéma"],"answer":0,"explanation":"Courbe.","level":1,"skill":"choisir"},{"type":"vf","q":"L'échelle n'a pas d'importance.","answer":false,"explanation":"Elle change la lecture.","level":1,"skill":"lire"},{"type":"trous",