e est le ___.","answer":"producteur","accept":[],"explanation":"Végétal.","level":2,"skill":"chaîne"},{"type":"vf","q":"Il faut manger au moins 5 fruits et légumes par jour.","answer":true,"explanation":"Recommandation.","level":1,"skill":"équilibre"},{"type":"qcm","q":"Un lion est…","choices":["herbivore","carnivore","omnivore","végétal"],"answer":1,"explanation":"Animaux.","level":1,"skill":"régimes"}]},{"level":"CM1","subject":"svt","catalogTitle":"Les milieux et la biodiversité","title":"Les milieux et la biodiversité","duration":20,"summary":"Habitats, adaptation, protection de la nature.","objectives":["Décrire un habitat","Comprendre l'adaptation","Protéger la nature"],"prerequisites":["Aucun"],"pitfalls":["Penser que les espèces vivent n'importe où"],"lesson":[{"title":"Les habitats","content":"Chaque être vivant vit dans un milieu : forêt, mer, désert, montagne, mare. Il y trouve nourriture et abri.","examples":["Poisson : eau"]},{"title":"L'adaptation","content":"Les êtres vivants sont adaptés : le chameau au désert, l'ours blanc au froid, le poisson à l'eau (branchies).","examples":["Fourrure épaisse, bosse"]},{"title":"Protéger la nature","content":"On protège les milieux : trier, ne pas jeter, créer des réserves, économiser l'eau.","examples":["Parc national"]}],"keyPoints":["Un habitat = un milieu","Adaptation","Protection"],"cards":[{"q":"Habitat ?","a":"Lieu de vie","explain":"","tag":""},{"q":"Adaptation ?","a":"Caractéristique utile dans un milieu","explain":"","tag":""},{"q":"Chameau ?","a":"Désert, bosse","explain":"","tag":""},{"q":"Ours blanc ?","a":"Froid, fourrure","explain":"","tag":""},{"q":"Biodiversité ?","a":"Diversité du vivant","explain":"","tag":""},{"q":"Réserve naturelle ?","a":"Espace protégé","explain":"","tag":""},{"q":"Geste pour protéger ?","a":"Trier les déchets","explain":"","tag":""},{"q":"Poisson respire par…","a":"Branchies","explain":"","tag":""}],"questions":[{"type":"qcm","q":"Le chameau vit…","choices":["dans le désert","dans la mer","au pôle Nord","en forêt"],"answer":0,"explanation":"Désert.","level":1,"skill":"habitats"},{"type":"qcm","q":"Un poisson respire grâce à ses…","choices":["poumons","branchies","plumes","écailles"],"answer":1,"explanation":"Branchies.","level":1,"skill":"adaptation"},{"type":"vf","q":"Trier les déchets protège la nature.","answer":true,"explanation":"Oui.","level":1,"skill":"protection"},{"type":"assoc","q":"Relie chaque animal à son milieu.","pairs":[["Ours blanc","banquise"],["Chameau","désert"],["Poisson","eau"],["Hibou","forêt"]],"explanation":"Milieux.","level":1,"skill":"habitats"},{"type":"trous","q":"La diversité du vivant s'appelle la ___.","answer":"biodiversité","accept":["biodiversite"],"explanation":"Mot clé.","level":2,"skill":"biodiversité"},{"type":"qcm","q":"Une réserve naturelle est…","choices":["un espace protégé","une décharge","un zoo seulement","un champ"],"answer":0,"explanation":"Protégé.","level":2,"skill":"protection"},{"type":"vf","q":"Tous les animaux peuvent vivre partout.","answer":false,"explanation":"Adaptés à un milieu.","level":1,"skill":"adaptation"},{"type":"qcm","q":"L'ours blanc a une fourrure épaisse pour…","choices":["se protéger du froid","nager vite","voler","courir"],"answer":0,"explanation":"Froid.","level":1,"skill":"adaptation"}]}]}